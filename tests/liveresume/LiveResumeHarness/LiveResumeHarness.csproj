<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test harness for the "still running in another process" line on a session card (0.11.63). It
       references the app itself and drives its own MainWindow.RefuseLiveResume and
       SessionViewModel.ClearLiveElsewhere on a real WorkspaceCardView, rendered offscreen: nothing is
       shown on screen, the deck is not started and no session is touched. See tests/live-resume.tests.ps1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LiveResumeHarness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\TabTower.csproj" />
  </ItemGroup>

</Project>
