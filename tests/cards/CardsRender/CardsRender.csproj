<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders task cards and their hover panels from a real tasks file to a PNG, offscreen, with
       the app's own TaskItemView and resources, so a card layout can be checked without starting
       the deck or touching the screen. See tests/cards.render.ps1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CardsRender</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\TabTower.csproj" />
  </ItemGroup>

</Project>
