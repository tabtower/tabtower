<Window x:Class="TabTower.TogglesEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toggles (flags)" Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FF222222">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Toggle names are free text and may be Hebrew: direction follows the content
             (standing rule, see App.xaml). Id / value boxes override with LeftToRight. -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FlowDirection"
                    Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource Rtl}}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
        </Style>
        <!-- read-only value box on the details page: selectable + copyable, not editable -->
        <Style x:Key="ValueBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FF2A2A2A"/>
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
            <Setter Property="BorderBrush" Value="#FF3F3F3F"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="CopyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="📋"/>
            <Setter Property="ToolTip" Value="Copy"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF88AACC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="30"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <!-- ============ page 1: the list ============ -->
        <StackPanel x:Name="ListPage">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#FF999999"
                       Text="Toggles act as flags for external processes. Each toggle appears as a button in the toolbar, and its state (1/0) is written to a file any external process can read."/>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Icon" FontSize="11"/>
                <TextBlock Grid.Column="1" Text="Id" FontSize="11"
                           ToolTip="The flag file name. Set on creation and cannot be changed"/>
                <TextBlock Grid.Column="2" Text="Name" FontSize="11"/>
                <TextBlock Grid.Column="3" Text="Default" FontSize="11"
                           ToolTip="The initial state, while no flag file exists yet"/>
            </Grid>

            <ItemsControl x:Name="TogglesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Icon, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalContentAlignment="Center" Margin="0,0,6,0"/>
                            <!-- id doubles as the flag file name — English/LTR, locked once created -->
                            <TextBox Grid.Column="1" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding IdLocked}" FlowDirection="LeftToRight" Margin="0,0,6,0"
                                     ToolTip="{Binding IdHint}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IdLocked}" Value="True">
                                                <Setter Property="Background" Value="#FF2A2A2A"/>
                                                <Setter Property="Foreground" Value="#FF999999"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBox Grid.Column="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox Grid.Column="3" IsChecked="{Binding DefaultOn}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button Grid.Column="4" Content="ℹ" Click="Details_Click"
                                    ToolTip="Flag details: id, full path, state and commands"
                                    Background="Transparent" Foreground="#FF88AACC" BorderThickness="0"
                                    Cursor="Hand" FontSize="14"/>
                            <Button Grid.Column="5" Content="🗑" ToolTip="Delete toggle" Click="DeleteRow_Click"
                                    Background="Transparent" Foreground="#FFCC6666" BorderThickness="0"
                                    Cursor="Hand" FontSize="13"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="+ Add toggle" Click="Add_Click" HorizontalAlignment="Left" Margin="0,4,0,0"
                    Background="#FF3A3A3A" Foreground="White" BorderThickness="0" Padding="10,4" Cursor="Hand"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="OK" Width="90" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0"
                        Background="#FF3A6EA5" Foreground="White" BorderThickness="0" Padding="0,5"/>
                <Button Content="Cancel" Width="90" IsCancel="True"
                        Background="#FF3A3A3A" Foreground="White" BorderThickness="0" Padding="0,5"/>
            </StackPanel>
        </StackPanel>

        <!-- ============ page 2: flag details (same window) ============ -->
        <StackPanel x:Name="DetailsPage" Visibility="Collapsed">
            <!-- header = the toggle's own icon + name, so its direction follows the name -->
            <TextBlock x:Name="DetailsHeader" FontSize="14" Foreground="White" Margin="0,0,0,12"
                       FlowDirection="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource Rtl}}"/>

            <TextBlock Text="Id" FontSize="11" Foreground="#FF999999"/>
            <DockPanel Margin="0,2,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource CopyButton}" Click="CopyId_Click"/>
                <TextBox x:Name="DetailsId" Style="{StaticResource ValueBox}"/>
            </DockPanel>

            <TextBlock Text="Flag file path" FontSize="11" Foreground="#FF999999"/>
            <DockPanel Margin="0,2,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource CopyButton}" Click="CopyPath_Click"/>
                <TextBox x:Name="DetailsPath" Style="{StaticResource ValueBox}"/>
            </DockPanel>

            <TextBlock Text="Current state" FontSize="11" Foreground="#FF999999"/>
            <TextBox x:Name="DetailsState" Style="{StaticResource ValueBox}" Margin="0,2,30,10"/>

            <TextBlock Text="CLI commands" FontSize="11" Foreground="#FF999999"/>
            <DockPanel Margin="0,2,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource CopyButton}" Click="CopyCli_Click"/>
                <TextBox x:Name="DetailsCli" Style="{StaticResource ValueBox}"/>
            </DockPanel>

            <TextBlock Text="Reading the flag from an external process (PowerShell)" FontSize="11" Foreground="#FF999999"/>
            <DockPanel Margin="0,2,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource CopyButton}" Click="CopySnippet_Click"/>
                <TextBox x:Name="DetailsSnippet" Style="{StaticResource ValueBox}"/>
            </DockPanel>

            <TextBlock Text="Prompt for an AI agent: a description of the flag, to paste at an agent that will wire a process to it" FontSize="11"
                       Foreground="#FF999999" TextWrapping="Wrap"/>
            <DockPanel Margin="0,2,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource CopyButton}" Click="CopyPrompt_Click"/>
                <TextBox x:Name="DetailsPrompt" Style="{StaticResource ValueBox}" MaxHeight="110"
                         VerticalScrollBarVisibility="Auto"/>
            </DockPanel>

            <Button Content="◀ Back to the list" Click="Back_Click" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Background="#FF3A3A3A" Foreground="White" BorderThickness="0" Padding="12,5" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
