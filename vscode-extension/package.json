{
  "name": "sessiondeck-connector",
  "displayName": "SessionDeck Connector",
  "description": "Reports Claude Code tabs and the git branch to SessionDeck, and opens/resumes Claude sessions on request.",
  "version": "0.6.17",
  "publisher": "eyal-sinay",
  "repository": {
    "type": "git",
    "url": "https://github.com/eyalBPM/SessionDeck.git"
  },
  "icon": "assets/logo128.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "session manager",
    "windows",
    "productivity"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sessiondeck.sync",
        "title": "SessionDeck: Sync Now"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run licence && npm run compile",
    "licence": "node -e \"require('fs').copyFileSync('../LICENSE','LICENSE')\"",
    "compile": "tsc -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.94.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.9.3"
  }
}
