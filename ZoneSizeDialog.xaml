<Window x:Class="TabTower.ZoneSizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom zone size" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FF222222">
    <StackPanel Margin="16">
        <TextBlock Text="Zone width, as a share of the screen width:" Foreground="#FFCCCCCC" Margin="0,0,0,4"/>
        <TextBox x:Name="SizeBox" FlowDirection="LeftToRight" TextChanged="Size_Changed"
                 Background="#FF333333" Foreground="White" BorderBrush="#FF555555" Padding="4,2"/>
        <TextBlock Text="A fraction like 2/7, a percentage like 40%, or a decimal like 0.4 (between 5% and 90%)"
                   TextWrapping="Wrap" Foreground="#FF888888" FontSize="11" Margin="0,4,0,0"/>
        <TextBlock x:Name="PreviewText" Foreground="#FF7FB2E5" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="OK" Width="90" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0"
                    Background="#FF3A6EA5" Foreground="White" BorderThickness="0" Padding="0,5"/>
            <Button Content="Cancel" Width="90" IsCancel="True"
                    Background="#FF3A3A3A" Foreground="White" BorderThickness="0" Padding="0,5"/>
        </StackPanel>
    </StackPanel>
</Window>
