<Window x:Class="TabTower.PairingPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TabTower: phone access request" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True"
        ShowActivated="False" Background="#FF222222">
    <!-- Not activated on show and no default button: a prompt that appears while the user is
         typing elsewhere must not be answered by a stray Enter. The code is NOT shown here: the
         user reads it off the device and types it, which is what proves this prompt belongs to
         the device in their hand. Closing the window denies. -->
    <StackPanel Margin="16">
        <TextBlock Text="A device is asking to use the phone page:" Foreground="#FFCCCCCC"/>
        <TextBlock x:Name="DeviceText" Foreground="White" FontSize="16" FontWeight="SemiBold"
                   TextWrapping="Wrap" Margin="0,6,0,0"/>
        <TextBlock x:Name="DetailText" Foreground="#FF888888" FontSize="11" TextWrapping="Wrap"/>
        <TextBlock Text="To approve it, type the 4-character code that device is showing:"
                   Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,12,0,4"/>
        <TextBox x:Name="CodeBox" FontFamily="Consolas" FontSize="24" MaxLength="4"
                 CharacterCasing="Upper" FlowDirection="LeftToRight" HorizontalContentAlignment="Center"
                 Width="140" HorizontalAlignment="Center" Padding="4,2" TextChanged="Code_Changed"
                 Background="#FF333333" Foreground="White" BorderBrush="#FF555555"
                 ToolTip="The code on the device's own screen. It is not shown here on purpose."/>
        <TextBlock x:Name="ErrorText" Foreground="#FFFF6B6B" TextWrapping="Wrap" Margin="0,6,0,0"
                   HorizontalAlignment="Center" Visibility="Collapsed"/>
        <TextBlock TextWrapping="Wrap" Foreground="#FF888888" FontSize="11" Margin="0,10,0,0"
                   Text="An approved device can list, open, close and reopen your Claude Code sessions until you revoke it in ⚙ → Phone access settings. If you did not just open the page on a device of yours, deny. Closing this window also denies."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Deny" Width="90" IsCancel="True" Click="Deny_Click" Margin="0,0,8,0"
                    ToolTip="Refuse this device. It cannot ask again for the next 10 minutes."
                    Background="#FF3A3A3A" Foreground="White" BorderThickness="0" Padding="0,5"/>
            <Button x:Name="ApproveButton" Content="Approve" Width="90" Click="Approve_Click" IsEnabled="False"
                    ToolTip="Let this device use the phone page until you revoke it. Needs the code from its screen."
                    Background="#FF3A6EA5" Foreground="White" BorderThickness="0" Padding="0,5"/>
        </StackPanel>
    </StackPanel>
</Window>
