<Window x:Class="TabTower.PhoneAccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone access" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FF222222">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Background" Value="#FF3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Foreground="#FFCCCCCC"
                   Text="See your Claude Code sessions on your phone and open, close or reopen them from anywhere on your tailnet. The page listens on this PC only and is reached through Tailscale."/>
        <CheckBox x:Name="EnabledBox" Content="Phone access on" Foreground="White" Margin="0,12,0,0"
                  ToolTip="Start or stop the page. Off, nothing listens at all."/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Port on 127.0.0.1:" Foreground="#FFCCCCCC" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="PortBox" Width="80" FlowDirection="LeftToRight" TextChanged="Port_Changed"
                     Background="#FF333333" Foreground="White" BorderBrush="#FF555555" Padding="4,2"
                     ToolTip="1024 to 65535. Only this PC can connect to it directly."/>
            <TextBlock x:Name="StateText" Foreground="#FF7FB2E5" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <TextBlock Style="{StaticResource Heading}" Text="Reach it from your phone"/>
        <TextBlock Style="{StaticResource Note}" Foreground="#FFCCCCCC"
                   Text="Run this once in a terminal on this PC. Tailscale keeps it across restarts:"/>
        <DockPanel Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource SmallButton}" Click="Copy_Click"
                    ToolTip="Copy the command to the clipboard"/>
            <TextBox x:Name="CommandBox" IsReadOnly="True" FlowDirection="LeftToRight" FontFamily="Consolas"
                     Background="#FF333333" Foreground="White" BorderBrush="#FF555555" Padding="4,2"/>
        </DockPanel>
        <TextBlock x:Name="UrlText" Style="{StaticResource Note}" Foreground="#FFCCCCCC" Margin="0,6,0,0"/>
        <TextBlock Style="{StaticResource Note}" Foreground="#FFF0964B" Margin="0,4,0,0"
                   Text="Never use tailscale funnel for this. The page refuses traffic from the public internet, but a funnel would still publish this PC's address."/>

        <TextBlock x:Name="PendingHeading" Style="{StaticResource Heading}" Text="Waiting for your answer"/>
        <TextBlock x:Name="PendingNote" Style="{StaticResource Note}"
                   Text="Approve in the request's own prompt, by typing the code the device shows. Here you can only deny."/>
        <ItemsControl x:Name="PendingList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,2">
                        <Button DockPanel.Dock="Right" Content="Deny" Tag="{Binding StableId}" Click="DenyPending_Click"
                                Style="{StaticResource SmallButton}" ToolTip="Refuse this device for the next 10 minutes"/>
                        <TextBlock Text="{Binding Title}" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource Heading}" Text="Approved devices"/>
        <ItemsControl x:Name="DevicesList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,2">
                        <Button DockPanel.Dock="Right" Content="Revoke" Tag="{Binding StableId}" Click="Revoke_Click"
                                Style="{StaticResource SmallButton}"
                                ToolTip="Remove this device. Its next visit has to be approved again."/>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Note}"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="NoDevicesText" Style="{StaticResource Note}"
                   Text="None yet. Open the page on your phone; this PC then asks you to approve it."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="OK" Width="90" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0"
                    Background="#FF3A6EA5" Foreground="White" BorderThickness="0" Padding="0,5"/>
            <Button Content="Cancel" Width="90" IsCancel="True"
                    Background="#FF3A3A3A" Foreground="White" BorderThickness="0" Padding="0,5"/>
        </StackPanel>
    </StackPanel>
</Window>
