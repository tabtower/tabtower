<Window x:Class="TabTower.EditCardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit card" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FF222222">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <!-- Free-text boxes hold user data, which is often Hebrew: direction and
             alignment follow what is actually typed (standing rule, see App.xaml).
             ASCII-only fields override this with an explicit LeftToRight. -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FlowDirection"
                    Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource Rtl}}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <CheckBox x:Name="AutoTitleCheck" Content="Automatic title" Checked="AutoTitle_Changed" Unchecked="AutoTitle_Changed"/>
        <TextBlock Text="Title:"/>
        <TextBox x:Name="TitleBox"/>
        <TextBlock Text="Description:"/>
        <TextBox x:Name="DescBox"/>
        <StackPanel x:Name="ColorSection">
            <CheckBox x:Name="AutoColorCheck" Content="Automatic color (Peacock / default)"
                      Checked="AutoColor_Changed" Unchecked="AutoColor_Changed"/>
            <TextBlock Text="Card color (name or #RRGGBB):"/>
            <DockPanel Margin="0,0,0,10">
                <Border x:Name="ColorPreview" DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="3"
                        BorderBrush="#FF555555" BorderThickness="1" Margin="0,0,8,0"/>
                <TextBox x:Name="ColorBox" Margin="0" FlowDirection="LeftToRight" TextChanged="Color_Changed"/>
            </DockPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="90" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0"
                    Background="#FF3A6EA5" Foreground="White" BorderThickness="0" Padding="0,5"/>
            <Button Content="Cancel" Width="90" IsCancel="True"
                    Background="#FF3A3A3A" Foreground="White" BorderThickness="0" Padding="0,5"/>
        </StackPanel>
    </StackPanel>
</Window>
